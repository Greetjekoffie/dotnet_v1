@model IEnumerable<MyFirstWebsite.Models.Product>

<div class="row">
    @foreach(var product in Model){
        <div class="card" style="width: 18rem; margin: 1rem">
        <img src="@Url.Action("GetImage", "Home", new { productId = product.Id })" class="card-img-top" alt="item image">
        <div class="card-body">
            <b class="card-title" style="font-size: 18px; display: block; text-align: center">@product.Name</b>
            <p class="card-text">Price: €@product.Price</p>
            <div style="display: flex;">
                <button style="margin-left: auto;" onClick="updateCart(@product.Id)">
                    <i id="cart-icon-@product.Id" class="bi bi-cart-plus"></i>
                </button>
            </div>
        </div>
        </div>
    }
</div>


<i class="bi bi-cart-check-fill"></i>